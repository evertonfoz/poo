<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SistemaGestaoEventosAcademicos.Apresentacao.Desktop.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="SistemaGestaoEventosAcademicos.Apresentacao.Desktop.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" Margin="24">

            <!-- Banner de Boas-vindas -->
            <Border Background="{DynamicResource AccentButtonBackground}"
                    CornerRadius="12"
                    Padding="24">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Bem-vindo ao Sistema de Gestão de Eventos Acadêmicos"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock Text="Ambiente acadêmico integrado com validação estrita de regras de negócio (RN01 a RN25)."
                                   FontSize="14"
                                   Foreground="#E2E8F0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="🎓"
                               FontSize="48"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"/>
                </Grid>
            </Border>

            <!-- Cards de Métricas Principais -->
            <WrapPanel Orientation="Horizontal">

                <!-- Card 1: Total Eventos -->
                <Border Width="240"
                        Height="130"
                        Margin="0,0,16,16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Total de Eventos" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="📅" FontSize="18"/>
                        </Grid>
                        <TextBlock Text="{Binding TotalEventos}" FontSize="32" FontWeight="Bold"/>
                        <TextBlock Text="{Binding EventosInscricoesAbertas, StringFormat='{}{0} com inscrições abertas'}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SystemAccentColor}"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Participantes -->
                <Border Width="240"
                        Height="130"
                        Margin="0,0,16,16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Participantes" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="👥" FontSize="18"/>
                        </Grid>
                        <TextBlock Text="{Binding TotalParticipantes}" FontSize="32" FontWeight="Bold"/>
                        <TextBlock Text="Cadastros validados (CPF e E-mail)"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Inscrições Ativas -->
                <Border Width="240"
                        Height="130"
                        Margin="0,0,16,16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Inscrições Ativas" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="📝" FontSize="18"/>
                        </Grid>
                        <TextBlock Text="{Binding TotalInscricoesAtivas}" FontSize="32" FontWeight="Bold"/>
                        <TextBlock Text="Sem choques de horário"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Card 4: Ocupação -->
                <Border Width="240"
                        Height="130"
                        Margin="0,0,16,16"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Ocupação Média" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="📈" FontSize="18"/>
                        </Grid>
                        <TextBlock Text="{Binding TaxaOcupacaoGeral, StringFormat='{}{0:F1}%'}" FontSize="32" FontWeight="Bold"/>
                        <ProgressBar Value="{Binding TaxaOcupacaoGeral}" Maximum="100" Height="6" CornerRadius="3"/>
                    </StackPanel>
                </Border>

            </WrapPanel>

            <!-- Seção de Ações Rápidas -->
            <StackPanel Spacing="12">
                <TextBlock Text="Acesso Rápido aos Módulos" FontSize="16" FontWeight="SemiBold"/>
                <Grid ColumnDefinitions="*,*,*">
                    <Border Grid.Column="0" Margin="0,0,8,0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="📅 Gerenciar Eventos" FontWeight="Medium"/>
                            <TextBlock Text="Cadastre novos eventos, defina cronogramas e adicione minicursos." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Margin="4,0,4,0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="👥 Novos Participantes" FontWeight="Medium"/>
                            <TextBlock Text="Registro com validação algorítmica de CPF e e-mail no ato." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Margin="8,0,0,0" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="6">
                            <TextBlock Text="🎟️ Credenciamento Rápido" FontWeight="Medium"/>
                            <TextBlock Text="Check-in instantâneo de presença com bloqueio de duplicidade." FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>

</UserControl>
